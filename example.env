# Copy to .env (git-ignored) and fill in. Never commit real values.

# Model gateway (Anthropic-compatible)
ANTHROPIC_BASE_URL=https://gateway.example.com
ANTHROPIC_API_KEY=
CLOUDOBSAI_MODEL=claude-sonnet-5-5

# Existing Docker network shared with Grafana and Alertmanager
OBS_DOCKER_NETWORK=

# Grafana root URL. If it enforces its domain (GF_SERVER_ENFORCE_DOMAIN), use the public URL:
# internal URLs get a 301 to it.
GRAFANA_URL=
# Only if that hostname must resolve to the Docker host from inside the containers
GRAFANA_HOSTNAME=
# Service account with the Viewer role
GRAFANA_SERVICE_ACCOUNT_TOKEN=
JAEGER_DATASOURCE_UID=

# Random token between the app and the MCP server: openssl rand -hex 32
MCP_GRAFANA_SERVER_TOKEN=

# Chat. Comma-separated space IDs (spaces/XXXX) where mentions are answered
CLOUDOBSAI_ALLOWED_SPACES=
# JSON mapping the alert's `space` label to a Chat space, e.g. {"network":"spaces/XXXX"}
CLOUDOBSAI_ALERT_SPACES={}
# projects/<project>/subscriptions/<name>
CLOUDOBSAI_PUBSUB_SUBSCRIPTION=
# Random token Alertmanager sends to the webhook: openssl rand -hex 32
CLOUDOBSAI_WEBHOOK_TOKEN=

# Host paths: data directory and service account key, owned by uid 10010 (the container user)
CLOUDOBSAI_DATA_PATH=./data
CLOUDOBSAI_SA_KEY_PATH=./secrets/chat-sa.json
